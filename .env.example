# --- Twilio ---
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- ElevenLabs (for generating synthetic test call audio) ---
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# --- Postgres ---
DATABASE_URL=postgresql://ccbot:ccbot_pw@localhost:5432/checkcallbot

# --- App ---
# Your public ngrok URL, e.g. https://abcd1234.ngrok-free.app
# Fill this in AFTER you start ngrok (Step 6 in README).
# REQUIRED as of Step 2 — the app uses this to build the wss:// media stream
# URL that Twilio's <Stream> TwiML connects to. No trailing slash.
PUBLIC_BASE_URL=

# Whisper model size: tiny, base, small, medium, large
# 'base' is a good speed/accuracy tradeoff for a CPU laptop
WHISPER_MODEL=base
